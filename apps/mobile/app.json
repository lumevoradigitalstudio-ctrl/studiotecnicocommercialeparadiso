{
  "expo": {
    "name": "RITMO AI",
    "slug": "ritmo-ai",
    "scheme": "ritmo",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "ios": {
      "bundleIdentifier": "app.ritmo.dev"
    },
    "android": {
      "package": "app.ritmo.dev",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2F6B57"
      }
    },
    "icon": "./assets/icon.png"
  }
}